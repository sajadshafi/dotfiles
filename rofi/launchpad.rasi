configuration {
    modes: "window,drun,run,ssh";
    show-icons: true;
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}


* {
    font: "JetBrainsMono Nerd Font 10";

    /* Everforest Dark (medium) */
    black:		#232a2e;
    white:		#FFFFFF;
    background:		#343f44;
    foreground:		#d3c6aa;
    primary:		#a7c080;
    primaryLight:	#83c092;
    onPrimary:		#2d353b;
    red:		#e67e80;
    transparent:	#00000000;
    transparentBg:	#2d353bE6;
    overlayBg:		#232a2eD9;
    urgent:		#e67e80;

    background-color: transparent;
    text-color:       @foreground;
    padding:          0px;
    margin:           0px;
}

window {
    fullscreen: true;
    padding: 8em;
    border: 0;
    background-color: @overlayBg;
}

mainbox {
    padding:  8px;
}

inputbar {
    margin: 10px calc(30% - 100px);
    padding: 0px 16px;
    children:   [ "textbox-prompt-colon", entry ];
}

textbox-prompt-colon {
    font:		"JetBrainsMono Nerd Font 20";
    enabled:		true;
    width:		65px;
    height:		40px;
    expand:             false;
    str:                "";
    padding:		15px 20px;
    border-radius:      25px 0px 0px 25px;
    background-color:   @primary;
    text-color:         @onPrimary;
}

entry {
    font:		"JetBrainsMono Nerd Font 16";
    border:		2px;
    margin:		0 0 0 -6px;
    padding:		18px 20px;
    background-color:	@transparentBg;
    border-color:	@primary;
    border-radius:	0px 25px 25px 0px;
    placeholder:        "Search";
    text-color:		@foreground;
    placeholder-color:  @primaryLight;
}

listview {
  margin:   48px calc( 40% - 500px );
  spacing:  48px;
  columns:  6;
  fixed-columns: true;
  background-color: transparent;
}

element, element-text, element-icon {
  cursor: pointer;
}

element {
    padding:		12px;
    spacing:		4px;
    orientation:	vertical;
    border-radius:	18px;
    background-color:	transparent;
    text-color:		@foreground;
}

/* Explicit per-state rules so rofi's default theme can't paint
   alternate rows a light (unreadable) colour. */
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color:	transparent;
    text-color:		@foreground;
}

element normal.urgent,
element alternate.urgent {
    background-color:	transparent;
    text-color:		@red;
}

element selected.normal,
element selected.active {
    background-color:	@transparentBg;
    text-color:		@foreground;
    border:		2px;
    border-color:	@primary;
}

element selected.urgent {
    background-color:	@red;
    text-color:		@onPrimary;
}

element-icon {
  size: 4em;
  horizontal-align: 0.5;
  background-color: transparent;
}

element-text {
  horizontal-align: 0.5;
  background-color: transparent;
  text-color: inherit;
}
